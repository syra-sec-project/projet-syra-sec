# Configuration Flask
FLASK_APP=backend/app.py
FLASK_DEBUG=1
SECRET_KEY=remplacer_par_une_cle_secrete_locale

# Sécurité JWT (Authentification)
JWT_SECRET_KEY=remplacer_par_un_secret_jwt_local

# Base de données (SQLite par défaut pour le développement)
DATABASE_URL=sqlite:///syra_dev.db

# Paramètres de sécurité de l'application
MAX_CONTENT_LENGTH=16777216  # Limite d'upload (ex: 16MB) pour contrer les dénis de service
